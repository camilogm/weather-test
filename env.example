# Copiar a .env  ->  make env    (o: cp env.example .env)
# El compose y el Makefile leen de aca. NUNCA commitear el .env real.

# ---- Postgres ----
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather_local_dev
POSTGRES_PORT=5432

# ---- Backend ----
# Providers soportados: Postgres | Sqlite
# Sqlite es el fallback si no queres/podes levantar Postgres.
DATABASE_PROVIDER=Postgres
API_PORT=8080

# ---- Frontend ----
# URL base que el front usa para pegarle al backend.
VITE_API_BASE_URL=http://localhost:8080
FRONTEND_PORT=5173
